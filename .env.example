# --- API keys ---
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Benchmark-only baselines (RecoveryBench comparison, not used in the product flow) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Backend ---
# SQLite locally. Production uses managed Postgres, injected by App Platform as
# ${db.DATABASE_URL} - do not set a Postgres URL here. Both `postgres://` and
# `postgresql://` are accepted; the scheme is normalised in app/db/session.py.
DATABASE_URL=sqlite:///./relay.db
API_PORT=8000
BACKEND_BASE_URL=http://localhost:8000

# Extra CORS origins, comma-separated, on top of the built-in localhost:3000.
# Unset in production: the deployed frontend and API share one origin.
CORS_ALLOW_ORIGINS=

# --- Frontend ---
# BUILD-time only - NEXT_PUBLIC_* is inlined into the client bundle by the
# compiler and cannot be changed by a runtime env var. Leave it UNSET in
# production: the client then uses same-origin relative paths, which is
# correct because /api and / are served by one App Platform app.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same value as ELEVENLABS_AGENT_ID above. Not a secret, just an identifier —
# the browser widget needs it client-side to open a session directly.
# Requires the agent's visibility set to "Public" in the ElevenLabs dashboard.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
